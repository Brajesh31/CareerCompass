root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,cff}]
indent_size = 2

[*.ipynb]
indent_size = 1

[*.{pkl,pickle,png,jpg,jpeg,gif,webp,pdf}]
insert_final_newline = false

[*.py]
indent_size = 4

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[*.sh]
indent_size = 2
