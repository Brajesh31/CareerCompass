# Local Google OAuth values read by app.py through python-dotenv.
# Create an OAuth client in Google Cloud and use the correct client for your
# deployment. Never replace these examples with real credentials in Git.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# OAuth redirect URI is currently hard-coded in app.py; this sample cannot
# change it. Update the application and OAuth client settings for local use.
#
# The current job-search API key is hard-coded in app.py and is exposed in the
# repository history. Revoke/rotate it, then change the application to read a
# replacement from a secret manager before adding any API-key variable here.
# Copy this sample to .env for local development; keep the real .env untracked.
# The OAuth values are required by the current login flow; do not use production credentials in shared development.
# GOOGLE_CLIENT_ID identifies the OAuth client and is not a substitute for the client secret.
