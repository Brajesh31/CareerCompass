# Detect text files and normalize committed text to LF.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cff text eol=lf
*.ipynb text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Preserve binary model artifacts, images, archives, and documents unchanged.
*.pkl binary
*.pickle binary
*.gif binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
/.env.example text eol=lf
/.editorconfig text eol=lf
/.gitignore text eol=lf
/CODEOWNERS text eol=lf
